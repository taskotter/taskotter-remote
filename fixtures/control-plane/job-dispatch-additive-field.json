{
  "protocol_version": "remote.v1alpha1",
  "message_type": "job.dispatch",
  "control_plane_build": "taskotter-control-plane-fixture+additive",
  "payload": {
    "lease_id": "lease_fixture_additive_001",
    "job_id": "job_fixture_additive_001",
    "runner_id": "local-dev-runner",
    "correlation_id": "corr_fixture_additive_001",
    "idempotency_key": "idem_fixture_additive_001",
    "adapter": "echo",
    "input": {
      "echo": "additive fixture remains compatible"
    },
    "timeout_seconds": 60,
    "dispatch_priority": "normal",
    "policy": {
