        "write_job_workspace"
      ],
      "policy_explain_ref": "policy-explain-fixture-additive",
      "workspace": {
        "workspace_id": "workspace_fixture_001",
        "root_strategy": "temporary_isolated",
        "allowed_env": [
          "PATH",
          "TMPDIR"
        ],
        "scoped_credential_ref": "runner-scoped-credential-ref",
        "artifact_path_allowlist": [
          "stdout.txt"
        ],
        "workspace_hint": "ignored-by-remote-v1alpha1"
      },
      "network": {
        "mode": "deny_all",
        "allowed_targets": [],
        "egress_policy_revision": "ignored-by-remote-v1alpha1"
      }
    }
  }
}
